require "./spec_helper"

module MessageSpecData
  ID         = UUID.new("00112233-4455-6677-8899-aabbccddeeff")
  DIGEST_HEX = "8f434346648f6b96df89dda901c5176b10a6d83961dd3c1ac88b59b2dc327aa4" # sha256("hi")
  # Frame laid out by hand from the table in src/message/clientmessage.go, not
  # generated by this shard. `output_stream_data` is 18 bytes, space-padded to
  # 32. CreatedDate is 1234567890 (0x499602d2) ms, sequence 5, flags SYN|FIN.
  WIRE = Bytes[
    0x00, 0x00, 0x00, 0x74,                                                       # header length 116
    0x6f, 0x75, 0x74, 0x70, 0x75, 0x74, 0x5f, 0x73, 0x74, 0x72, 0x65, 0x61, 0x6d, # "output_stream"
    0x5f, 0x64, 0x61, 0x74, 0x61, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, # "_data" + padding
    0x20, 0x20, 0x20, 0x20, 0x20, 0x20,                                           # remaining padding
    0x00, 0x00, 0x00, 0x01,                                                       # schema version
    0x00, 0x00, 0x00, 0x00, 0x49, 0x96, 0x02, 0xd2,                               # created date
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x05,                               # sequence number
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03,                               # flags SYN|FIN
    0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff,                               # UUID LSB half
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,                               # UUID MSB half
    0x8f, 0x43, 0x43, 0x46, 0x64, 0x8f, 0x6b, 0x96, 0xdf, 0x89, 0xdd, 0xa9, 0x01, 0xc5, 0x17, 0x6b,
    0x10, 0xa6, 0xd8, 0x39, 0x61, 0xdd, 0x3c, 0x1a, 0xc8, 0x8b, 0x59, 0xb2, 0xdc, 0x32, 0x7a, 0xa4, # digest
    0x00, 0x00, 0x00, 0x01,                                                                         # payload type Output
    0x00, 0x00, 0x00, 0x02,                                                                         # payload length
    0x68, 0x69,                                                                                     # "hi"
  ]
end

describe KrikriAwsSsm::Message do
  it "decodes a frame using the pinned header offsets" do
    message = KrikriAwsSsm::Message.decode(MessageSpecData::WIRE)

    assert_equal 116_u32, message.header_length
    assert_equal "output_stream_data", message.message_type
    assert_equal 1_u32, message.schema_version
    assert_equal 1234567890_u64, message.created_date
    assert_equal 5_i64, message.sequence_number
    assert_equal 3_u64, message.flags
    assert message.syn?
    assert message.fin?
    assert_equal MessageSpecData::ID, message.message_id
    assert_equal MessageSpecData::DIGEST_HEX.hexbytes, message.payload_digest.to_slice
    assert_equal KrikriAwsSsm::PayloadType::Output.value, message.payload_type
    assert_equal "hi", String.new(message.payload)
  end

  it "encodes the same bytes as the pinned frame" do
    message = KrikriAwsSsm::Message.new(
      message_type: "output_stream_data",
      payload: "hi".to_slice,
      payload_type: KrikriAwsSsm::PayloadType::Output.value,
      sequence_number: 5_i64,
      flags: KrikriAwsSsm::Flags::ACK,
      message_id: MessageSpecData::ID,
      created_date: 1234567890_u64,
    )
    assert_equal MessageSpecData::WIRE, message.encode
  end

  it "always writes a digest, including the digest of an empty payload" do
    message = KrikriAwsSsm::Message.new(message_type: "input_stream_data")
    encoded = message.encode
    assert_equal 120, encoded.size
    assert_equal "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855".hexbytes,
      encoded[80, 32].to_slice
  end

  it "rejects a payload whose digest does not match" do
    corrupted = MessageSpecData::WIRE.dup
    corrupted[80] = 0x00_u8
    error = assert_raises(KrikriAwsSsm::DigestMismatch) do
      KrikriAwsSsm::Message.decode(corrupted)
    end
    assert_equal "output_stream_data", error.message_type
  end

  it "skips digest validation for an empty payload, matching ClientMessage.Validate" do
    frame = KrikriAwsSsm::Message.new(message_type: "output_stream_data").encode
    frame[80] = 0x00_u8
    message = KrikriAwsSsm::Message.decode(frame)
    assert message.payload.empty?
  end

  it "skips digest validation for start_publication and pause_publication" do
    {"start_publication", "pause_publication"}.each do |type|
      frame = Bytes.new(121)
      frame[0, 4].copy_from(Bytes[0x00, 0x00, 0x00, 0x74])
      frame[4, 32].fill(' '.ord.to_u8)
      type.to_slice.copy_to(frame[4, type.bytesize])
      frame[36, 4].copy_from(Bytes[0x00, 0x00, 0x00, 0x01])
      frame[40, 8].copy_from(Bytes[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01])
      frame[48, 8].copy_from(Bytes[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])
      frame[56, 8].copy_from(Bytes[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])
      frame[64, 16].copy_from(KrikriAwsSsm::UUIDCodec.encode(MessageSpecData::ID))
      frame[80, 32].fill(0x00_u8)
      frame[112, 4].copy_from(Bytes[0x00, 0x00, 0x00, 0x00])
      frame[116, 4].copy_from(Bytes[0x00, 0x00, 0x00, 0x01])
      frame[120] = 0x78_u8

      message = KrikriAwsSsm::Message.decode(frame)
      assert_equal type, message.message_type
      assert_equal "x", String.new(message.payload)
    end
  end

  it "rejects a frame shorter than the header" do
    error = assert_raises(KrikriAwsSsm::ProtocolError) do
      KrikriAwsSsm::Message.decode(Bytes.new(119))
    end
    assert_equal "message shorter than its 120-byte header", error.message
  end

  it "rejects a header length other than 116" do
    frame = KrikriAwsSsm::Message.new(message_type: "input_stream_data").encode
    frame[0, 4].copy_from(Bytes[0x00, 0x00, 0x00, 0x6f])
    error = assert_raises(KrikriAwsSsm::ProtocolError) do
      KrikriAwsSsm::Message.decode(frame)
    end
    assert_equal "unexpected header length 111, expected 116", error.message
  end

  it "rejects a payload length that disagrees with the frame size" do
    frame = KrikriAwsSsm::Message.new(message_type: "input_stream_data", payload: "hi".to_slice).encode
    frame[116, 4].copy_from(Bytes[0x00, 0x00, 0x00, 0x03])
    error = assert_raises(KrikriAwsSsm::ProtocolError) do
      KrikriAwsSsm::Message.decode(frame)
    end
    assert_equal "payload length 3 does not match frame size 2", error.message
  end

  it "rejects a payload length above 2^31 as a ProtocolError, not an OverflowError" do
    frame = KrikriAwsSsm::Message.new(message_type: "input_stream_data", payload: "hi".to_slice).encode
    frame[116, 4].copy_from(Bytes[0xc0, 0x00, 0x00, 0x00])
    error = assert_raises(KrikriAwsSsm::ProtocolError) do
      KrikriAwsSsm::Message.decode(frame)
    end
    assert_equal "payload length 3221225472 does not match frame size 2", error.message
  end

  it "round-trips the plugin's signed sequence numbers" do
    # Go declares SequenceNumber as int64; the parser reads it as a wrapping
    # uint64, so a negative sequence must survive encode/decode.
    message = KrikriAwsSsm::Message.new(
      message_type: "input_stream_data", sequence_number: -5_i64)
    assert_equal(-5_i64, KrikriAwsSsm::Message.decode(message.encode).sequence_number)
  end

  it "rejects a message type longer than 32 bytes" do
    error = assert_raises(KrikriAwsSsm::ProtocolError) do
      KrikriAwsSsm::Message.new(message_type: "x" * 33).encode
    end
    assert_equal "message type \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\" exceeds 32 bytes", error.message
  end
end
